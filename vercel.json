{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/v1/(.*)", "dest": "/server.js" },
    { "src": "/p/(.*)", "dest": "/server.js" },
    { "src": "/share/(.*)", "dest": "/server.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/(.*\\.(css|js|png|jpg|jpeg|svg|ico|json|md))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "cleanUrls": true
}
